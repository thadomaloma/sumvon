<% content_for :title, "#{t('passwords.reset.title')} · Sumvon" %>
<div class="auth-shell">
  <section class="auth-pane">
    <%= render "shared/auth_header", link_text: t("passwords.back_to_sign_in"), link_path: new_session_path %>

    <div class="auth-pane-body">
      <p class="page-eyebrow"><%= t("passwords.reset.eyebrow") %></p>
      <h1 class="auth-title mt-1"><%= t("passwords.reset.title") %></h1>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t("passwords.reset.body") %></p>

      <%= render "shared/auth_flashes" %>
      <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-5" do |form| %>
        <div data-controller="password-hint" data-password-hint-minimum-value="8">
          <%= form.label :password, t("passwords.reset.new_password"), class: "field-label" %>
          <%= password_field_with_toggle form, :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 8, maxlength: 72,
                aria: { describedby: "password-hint" }, data: { password_hint_target: "input", action: "input->password-hint#update" } %>
          <p id="password-hint" class="field-hint" data-password-hint-target="hint"><%= heroicon :check_circle, variant: :solid, class: "size-4 shrink-0" %><span><%= t("auth.password_hint") %></span></p>
        </div>
        <%= form.submit t("passwords.reset.submit"), class: "btn-primary auth-submit w-full", data: { turbo_submits_with: t("passwords.reset.saving") } %>
      <% end %>

      <p class="mt-5 text-xs leading-5 text-muted"><%= t("passwords.reset.security_note") %></p>
    </div>

    <p class="auth-pane-footer lg:hidden"><%= heroicon :lock_closed, class: "size-3.5" %><%= t("auth.private") %></p>
  </section>

  <%= render "shared/auth_visual" %>
</div>
