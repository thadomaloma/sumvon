<% content_for :title, "#{t('passwords.request.title')} · Sumvon" %>
<div class="auth-shell">
  <section class="auth-pane">
    <%= render "shared/auth_header", link_text: t("passwords.back_to_sign_in"), link_path: new_session_path %>

    <div class="auth-pane-body">
      <p class="page-eyebrow"><%= t("passwords.request.eyebrow") %></p>
      <h1 class="auth-title mt-1"><%= t("passwords.request.title") %></h1>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t("passwords.request.body") %></p>

      <%= render "shared/auth_flashes" %>
      <%= form_with url: passwords_path, class: "mt-6 space-y-5" do |form| %>
        <div>
          <%= form.label :email_address, t("passwords.email"), class: "field-label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, value: params[:email_address], class: "field" %>
        </div>
        <%= form.submit t("passwords.request.submit"), class: "btn-primary auth-submit w-full" %>
      <% end %>

      <p class="mt-5 rounded-xl border border-line bg-surface-muted px-4 py-3 text-xs leading-5 text-muted"><%= t("passwords.request.privacy") %></p>
          </div>

    <p class="auth-pane-footer lg:hidden"><%= heroicon :lock_closed, class: "size-3.5" %><%= t("auth.private") %></p>
  </section>

  <%= render "shared/auth_visual" %>
</div>
