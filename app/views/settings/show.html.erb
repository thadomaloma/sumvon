<div class="mx-auto max-w-2xl">
  <p class="page-eyebrow"><%= t("settings.eyebrow") %></p><h1 class="page-title mt-1"><%= t("settings.title") %></h1>
  <%= form_with model: @user, url: settings_path, class: "panel mt-6 space-y-5 p-5 sm:p-7", data: { controller: "country-currency", country_currency_map_value: CountryCatalog.currency_map.to_json } do |form| %>
    <%= render "shared/errors", object: @user %>
    <div><%= form.label :display_name, class: "field-label" %><%= form.text_field :display_name, class: "field", required: true %></div>
    <div class="grid gap-5 sm:grid-cols-2"><div><%= form.label :country_code, class: "field-label" %><%= form.select :country_code, country_options, {}, class: "field", data: { country_currency_target: "country", action: "change->country-currency#countryChanged" } %></div><div><%= form.label :default_currency, class: "field-label" %><%= form.select :default_currency, currency_options, {}, class: "field", data: { country_currency_target: "currency" } %></div></div>
    <p class="-mt-2 text-xs leading-5 text-muted"><%= t("settings.country_currency_hint") %></p>
    <div><%= form.label :timezone, class: "field-label" %><%= form.time_zone_select :timezone, ActiveSupport::TimeZone.all, {}, class: "field" %></div>
    <%= form.submit t("settings.save"), class: "btn-primary" %>
  <% end %>
  <div class="mt-5 flex items-center justify-between rounded-xl border border-line bg-white p-4"><div><p class="font-medium"><%= Current.user.email_address %></p><p class="text-sm text-muted"><%= t("settings.signed_in") %></p></div><%= button_to session_path, method: :delete, class: "btn-secondary inline-flex items-center gap-2", form: { data: { controller: "session-cleanup", action: "submit->session-cleanup#clear" } } do %><%= heroicon :arrow_right_on_rectangle, class: "size-5" %><%= t("auth.sign_out") %><% end %></div>
  <div class="mt-5 grid gap-3 sm:grid-cols-2">
    <%= link_to finance_tools_path, class: "btn-secondary inline-flex items-center gap-2" do %><%= heroicon :sparkles, class: "size-5" %><%= t("finance_tools.title") %><% end %>
    <%= link_to new_transaction_import_path, class: "btn-secondary inline-flex items-center gap-2" do %><%= heroicon :arrow_up_tray, class: "size-5" %><%= t("imports.title") %><% end %>
    <%= link_to financial_accounts_path, class: "btn-secondary inline-flex items-center gap-2" do %><%= heroicon :wallet, class: "size-5" %><%= t("accounts.title") %><% end %>
    <%= link_to transactions_path, class: "btn-secondary inline-flex items-center gap-2" do %><%= heroicon :arrows_right_left, class: "size-5" %><%= t("transactions.title") %><% end %>
  </div>

  <section class="panel mt-6 p-5 sm:p-7" data-pwa-target="installSection">
    <div class="flex items-start gap-4"><span class="brand-emblem size-11" aria-hidden="true"><%= image_tag "/icon.svg", alt: "", class: "size-full" %></span><div><h2 class="text-lg font-semibold"><%= t("pwa.mobile_app") %></h2><p class="mt-1 text-sm leading-6 text-muted"><%= t("pwa.install_description") %></p></div></div>
    <p class="mt-4 hidden text-sm text-brand" data-pwa-target="installedMessage"><%= t("pwa.installed") %></p>
    <div class="mt-5 flex flex-wrap items-start gap-3">
      <button type="button" class="btn-primary hidden items-center gap-2" data-action="pwa#install" data-pwa-target="installButton"><%= heroicon :arrow_down_tray, class: "size-5" %><%= t("pwa.install") %></button>
      <details class="group" data-pwa-target="installHelp">
        <summary class="btn-secondary cursor-pointer list-none"><%= t("pwa.install_help") %></summary>
        <div class="mt-3 max-w-md rounded-xl bg-surface-muted p-4 text-sm text-ink-soft">
          <p class="font-semibold"><%= t("pwa.ios_title") %></p>
          <ol class="mt-2 list-decimal space-y-1 pl-5"><li><%= t("pwa.ios_share") %></li><li><%= t("pwa.ios_home") %></li><li><%= t("pwa.ios_confirm") %></li></ol>
          <p class="mt-4 font-semibold"><%= t("pwa.browser_install_title") %></p>
          <p class="mt-2"><%= t("pwa.browser_install_body") %></p>
        </div>
      </details>
      <button type="button" class="btn-secondary inline-flex items-center gap-2 disabled:cursor-wait disabled:opacity-60" data-action="pwa#checkForUpdate" data-pwa-target="checkUpdateButton"><%= heroicon :arrow_path, class: "size-5" %><%= t("pwa.check_update") %></button>
    </div>
    <p class="mt-3 hidden text-sm text-muted" role="status" aria-live="polite" data-pwa-target="updateStatus"></p>
    <div class="mt-5 border-t border-line pt-4 text-xs leading-5 text-muted"><p><%= t("pwa.online_required") %></p><p class="mt-1"><%= t("pwa.version", version: ENV.fetch("APP_VERSION", "6.0")) %></p></div>
  </section>
</div>
