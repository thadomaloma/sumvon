<% content_for :title, "#{t('auth.sign_in')} · Sumvon" %>
<div class="auth-shell">
  <section class="auth-pane">
    <%= render "shared/auth_header", prompt: t("auth.no_account"), link_text: t("auth.create_account_instead"), link_path: new_registration_path %>

    <div class="auth-pane-body">
      <h1 class="auth-title"><%= t("auth.sign_in_title") %></h1>
      <p class="mt-2 text-sm leading-6 text-muted"><%= t("auth.sign_in_body") %></p>

      <% credentials_error = flash[:alert] == t("auth.invalid_credentials") %>
      <% error_aria = credentials_error ? { invalid: true, describedby: "auth-alert" } : {} %>
      <%= render "shared/auth_flashes" %>
      <%= form_with url: session_url, class: "mt-6 space-y-5" do |form| %>
        <div><%= form.label :email_address, class: "field-label" %><%= form.email_field :email_address, required: true, autofocus: params[:email_address].blank?, autocomplete: "username", autocapitalize: "none", spellcheck: false, value: params[:email_address], class: "field", aria: error_aria %></div>
        <div>
          <div class="flex items-center justify-between gap-3"><%= form.label :password, class: "field-label" %><%= link_to t("auth.forgot"), new_password_path, class: "text-xs font-semibold text-brand hover:underline" %></div>
          <%= password_field_with_toggle form, :password, required: true, autofocus: params[:email_address].present?, autocomplete: "current-password", maxlength: 72, aria: error_aria %>
        </div>
        <%= form.submit t("auth.sign_in"), class: "btn-primary auth-submit w-full", data: { turbo_submits_with: t("auth.signing_in") } %>
      <% end %>
    </div>

    <p class="auth-pane-footer lg:hidden"><%= heroicon :lock_closed, class: "size-3.5" %><%= t("auth.private") %></p>
  </section>

  <%= render "shared/auth_visual" %>
</div>
