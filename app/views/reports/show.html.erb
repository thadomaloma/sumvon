<% content_for :title, "#{t('reports.title')} · Sumvon" %>
<div><p class="page-eyebrow"><%= t("reports.eyebrow") %></p><h1 class="page-title mt-1"><%= t("reports.title") %></h1></div>

<nav class="panel mt-6 flex items-center justify-between p-2" aria-label="<%= t('reports.period_navigation') %>">
  <%= link_to monthly_report_path(@month.prev_month.year, @month.prev_month.month), class: "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-muted hover:bg-surface-muted" do %><%= heroicon :arrow_left, class: "size-4" %><%= l(@month.prev_month, format: '%b') %><% end %>
  <span class="font-semibold"><%= l(@month, format: "%B %Y") %></span>
  <% if @month < Date.current.beginning_of_month %><%= link_to monthly_report_path(@month.next_month.year, @month.next_month.month), class: "inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-semibold text-muted hover:bg-surface-muted" do %><%= l(@month.next_month, format: '%b') %><%= heroicon :arrow_right, class: "size-4" %><% end %><% else %><span class="px-3 py-2 text-sm text-line-strong" aria-hidden="true"><%= heroicon :arrow_right, class: "size-4" %></span><% end %>
</nav>

<% unless @summary.activity? %>
  <section class="panel mt-5 px-6 py-10 text-center"><%= heroicon :chart_bar, class: "mx-auto size-10 text-line-strong" %><h2 class="mt-3 text-lg font-semibold"><%= t("reports.empty_title", month: l(@month, format: "%B")) %></h2><p class="mt-2 text-sm text-muted"><%= t("reports.empty_body") %></p><div class="mt-5 flex justify-center gap-3"><%= link_to t("transactions.add"), new_transaction_path, class: "btn-primary" %><%= link_to t("budgets.create"), new_budget_path(month: @month.strftime("%Y-%m"), currency: @currency), class: "btn-secondary" %></div></section>
<% else %>
  <section class="panel mt-5 grid gap-px overflow-hidden bg-canvas sm:grid-cols-3">
    <div class="bg-surface p-5 sm:p-6"><p class="text-sm text-muted"><%= t("reports.income") %></p><p class="mt-2 text-2xl font-semibold tracking-tight"><%= money_tag(@summary.income_minor, @currency, sign: "+", class: "text-positive") %></p></div>
    <div class="bg-surface p-5 sm:p-6"><p class="text-sm text-muted"><%= t("reports.expenses") %></p><p class="mt-2 text-2xl font-semibold tracking-tight"><%= signed_money_tag(-@summary.expense_minor, @currency) %></p></div>
    <div class="bg-surface p-5 sm:p-6"><p class="text-sm text-muted"><%= t("reports.savings") %></p><p class="mt-2 text-2xl font-semibold tracking-tight"><%= signed_money_tag(@summary.savings_amount_minor, @currency) %></p><p class="mt-1 text-xs text-muted"><%= @summary.savings_rate.nil? ? t("reports.rate_unavailable") : t("reports.savings_rate", rate: @summary.savings_rate) %></p></div>
  </section>

  <section class="panel mt-5 px-5 sm:px-7"><div class="border-b border-line py-5"><h2 class="section-title text-lg"><%= t("reports.spending_by_category") %></h2><p class="mt-1 text-sm text-muted"><%= t("reports.category_help") %></p></div><div class="divide-y divide-line"><% @summary.category_breakdown.each do |row| %><div class="flex items-center gap-3 py-4"><%= category_icon_tag(row[:name]) %><div class="min-w-0 flex-1"><div class="flex justify-between gap-3"><div class="min-w-0"><p class="truncate font-medium"><%= row[:name] %></p><p class="mt-1 text-xs text-muted"><%= t("reports.transaction_count", count: row[:transaction_count]) %> · <%= row[:percentage] %>%</p></div><p class="shrink-0 font-semibold"><%= money_tag(row[:amount_minor], @currency) %></p></div><div class="mt-2.5 h-1.5 rounded-full bg-canvas"><div class="h-full rounded-full bg-brand" style="width: <%= progress_width(row[:percentage]) %>%"></div></div></div></div><% end %></div></section>

  <section class="panel mt-5 p-5 sm:p-7"><h2 class="section-title text-lg"><%= t("reports.comparison") %></h2><% if @comparison %><div class="mt-4 grid gap-3 sm:grid-cols-3"><% [ ["income", @comparison[:income_difference_minor]], ["expenses", @comparison[:expense_difference_minor]], ["savings", @comparison[:savings_difference_minor]] ].each do |label, value| %><div class="rounded-xl bg-surface-muted p-4"><p class="text-sm text-muted"><%= t("reports.#{label}") %></p><p class="mt-1 font-semibold tabular-nums"><%= difference_label(value, @currency) %></p><p class="mt-1 text-xs text-muted"><%= t("reports.vs_previous") %></p></div><% end %></div><% else %><p class="mt-2 text-sm text-muted"><%= t("reports.no_comparison") %></p><% end %></section>
<% end %>

<% if @trend_activity %><section class="panel mt-5 p-5 sm:p-7"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="section-title text-lg"><%= t("reports.trends") %></h2><p class="mt-1 text-sm text-muted"><%= t("reports.trends_help", currency: @currency) %></p></div><div class="flex rounded-lg bg-canvas p-1"><% [3, 6, 12].each do |range| %><%= link_to t("reports.months", count: range), monthly_report_path(@month.year, @month.month, range: range), class: "rounded-md px-2.5 py-1.5 text-xs font-semibold #{params[:range].to_i == range || (params[:range].blank? && range == 6) ? 'bg-white text-brand shadow-sm' : 'text-muted'}" %><% end %></div></div>
  <% max_trend = @trend.periods.flat_map { |period| [period[:income_minor].abs, period[:expense_minor].abs] }.max.to_i %>
  <div class="mt-6 space-y-4"><% @trend.periods.each do |period| %><div class="grid grid-cols-[3rem_1fr] items-center gap-3"><p class="text-xs font-medium text-muted"><%= l(period[:month], format: "%b") %></p><div><div class="flex items-center gap-2"><div class="h-2 rounded-full bg-income" style="width: <%= max_trend.zero? ? 0 : (period[:income_minor].abs.to_d / max_trend * 100).round %>%"></div><span class="whitespace-nowrap text-xs tabular-nums"><%= format_money(period[:income_minor], @currency) %></span></div><div class="mt-1.5 flex items-center gap-2"><div class="h-2 rounded-full bg-expense" style="width: <%= max_trend.zero? ? 0 : (period[:expense_minor].abs.to_d / max_trend * 100).round %>%"></div><span class="whitespace-nowrap text-xs tabular-nums"><%= difference_label(-period[:expense_minor], @currency) %></span></div></div></div><% end %></div><div class="mt-4 flex gap-4 text-xs text-muted"><span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-income"></span><%= t("reports.income") %></span><span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-expense"></span><%= t("reports.expenses") %></span></div>
  <%= form_with url: monthly_report_path(@month.year, @month.month), method: :get, class: "mt-6 border-t border-line pt-5" do |form| %><%= form.hidden_field :range, value: @trend.months %><%= form.label :category_id, t("reports.category_trend"), class: "field-label" %><div class="mt-2 flex gap-2"><%= form.select :category_id, [[t("reports.choose_category"), ""]] + @categories.map { |category| [category.name, category.id] }, { selected: @category&.id }, class: "min-h-11 flex-1 rounded-xl border border-line-strong bg-white px-3 text-sm" %><%= form.submit t("reports.show_trend"), class: "btn-secondary" %></div><% end %>
  <% if @category_trend %><div class="mt-5"><h3 class="font-semibold"><%= @category.name %></h3><div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-6"><% @category_trend.each do |period| %><div class="rounded-lg bg-surface-muted p-2 text-center"><p class="text-xs text-muted"><%= l(period[:month], format: "%b") %></p><p class="mt-1 text-xs font-semibold tabular-nums"><%= format_money(period[:amount_minor], @currency) %></p></div><% end %></div></div><% end %>
</section><% end %>

<section class="panel premium-side-card mt-5 overflow-hidden p-5 sm:p-7" data-report-position data-position-currency="<%= @position_currency %>">
  <div class="flex items-start justify-between gap-4">
    <div><p class="page-eyebrow"><%= @position_currency %></p><h2 class="mt-1 text-lg font-semibold"><%= t("reports.net_worth") %></h2><p class="mt-1 text-sm text-muted"><%= t("reports.net_worth_note", currency: @position_currency) %></p></div>
    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-tint text-brand"><%= heroicon :wallet, class: "size-5" %></span>
  </div>
  <p class="mt-5 text-4xl font-semibold tracking-[-0.035em] text-ink"><%= money_tag(@position[:net_worth_minor], @position_currency, show_code: true, class: "money-display") %></p>
  <p class="mt-2 text-xs font-medium text-muted"><%= t("reports.assets_liabilities", assets: format_money(@position[:assets_minor], @position_currency), liabilities: format_money(@position[:liabilities_minor], @position_currency)) %></p>
</section>
