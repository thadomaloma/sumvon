<div class="h-2 overflow-hidden rounded-full bg-canvas" role="progressbar" aria-valuenow="<%= percentage.round %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= label %>">
  <div class="h-full rounded-full <%= percentage >= 100 ? 'bg-amber-700' : percentage >= 90 ? 'bg-amber-500' : 'bg-brand' %>" style="width: <%= progress_width(percentage) %>%"></div>
</div>
