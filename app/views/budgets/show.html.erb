<% content_for :title, "#{t('budgets.title')} · Sumvon" %>
<div class="flex items-start justify-between gap-4"><div><p class="page-eyebrow"><%= l(@budget.reporting_month, format: "%B %Y") %> · <%= @budget.currency %></p><h1 class="page-title mt-1"><%= t("budgets.monthly_budget") %></h1></div><%= link_to edit_budget_path(@budget), class: "btn-secondary inline-flex items-center gap-2" do %><%= heroicon :pencil_square, class: "size-5" %><%= t("forms.edit") %><% end %></div>
<section class="panel mt-6 overflow-hidden p-5 sm:p-7">
  <div class="flex items-start justify-between gap-4"><div><p class="text-sm font-medium text-muted"><%= t("budgets.spent_of_plan") %></p><p class="mt-2 text-2xl font-semibold tabular-nums sm:text-3xl"><%= format_money(@summary.spent_amount_minor, @budget.currency) %> <span class="text-base font-normal text-subtle sm:text-lg">/ <%= format_money(@summary.planned_amount_minor, @budget.currency) %></span></p></div><span class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900"><%= budget_status_label(@summary.status) %></span></div>
  <div class="mt-5"><%= render "progress", percentage: @summary.used_percentage, label: t("budgets.used_label", percentage: @summary.used_percentage) %></div>
  <div class="mt-4 grid grid-cols-2 gap-4 text-sm sm:grid-cols-4"><div><p class="text-muted"><%= t("budgets.remaining") %></p><p class="mt-1 font-semibold tabular-nums"><%= format_money(@summary.remaining_amount_minor, @budget.currency) %></p></div><div><p class="text-muted"><%= t("budgets.used_short") %></p><p class="mt-1 font-semibold"><%= @summary.used_percentage %>%</p></div><div><p class="text-muted"><%= t("budgets.days_left") %></p><p class="mt-1 font-semibold"><%= @summary.days_remaining %></p></div><div><p class="text-muted"><%= t("budgets.unallocated") %></p><p class="mt-1 font-semibold tabular-nums"><%= format_money(@budget.unallocated_amount_minor, @budget.currency) %></p><% if @budget.rollover_amount_minor.positive? %><p class="mt-1 text-xs text-positive"><%= t("budgets.rolled_over", amount: format_money(@budget.rollover_amount_minor, @budget.currency)) %></p><% end %></div></div>
  <% if @budget.reporting_month == Date.current.beginning_of_month %><p class="mt-5 rounded-xl bg-surface-muted p-3 text-sm text-muted"><%= t("budgets.pacing", used: @summary.used_percentage, days: @summary.days_remaining) %></p><% end %>
</section>

<section class="panel mt-5 px-5 sm:px-7"><div class="border-b border-line py-5"><h2 class="text-lg font-semibold"><%= t("budgets.by_category") %></h2></div>
  <% if @summary.category_progress.any? %><div class="divide-y divide-line"><% @summary.category_progress.each do |row| %><div class="py-4"><div class="flex items-start justify-between gap-3"><div><p class="font-medium"><%= row[:category].name %></p><p class="mt-1 text-xs text-muted"><%= budget_status_label(row[:status]) %> · <%= row[:used_percentage] %>%</p></div><div class="text-right text-sm"><p class="font-semibold tabular-nums"><%= format_money(row[:spent_amount_minor], @budget.currency) %> / <%= format_money(row[:planned_amount_minor], @budget.currency) %></p><p class="mt-1 text-xs <%= row[:remaining_amount_minor].negative? ? 'text-amber-800' : 'text-muted' %>"><%= row[:remaining_amount_minor].negative? ? t("budgets.over_by", amount: format_money(row[:remaining_amount_minor].abs, @budget.currency)) : t("budgets.left", amount: format_money(row[:remaining_amount_minor], @budget.currency)) %></p></div></div><div class="mt-3"><%= render "progress", percentage: row[:used_percentage], label: t("budgets.category_used_label", category: row[:category].name, percentage: row[:used_percentage]) %></div></div><% end %></div><% else %><p class="py-8 text-center text-sm text-muted"><%= t("budgets.no_allocations") %></p><% end %>
</section>
<% if @summary.status == :over_budget %><div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm font-medium text-amber-950" role="alert"><%= t("budgets.overspending_alert", amount: format_money(@summary.remaining_amount_minor.abs, @budget.currency)) %></div><% end %>
<section class="panel mt-5 p-5 sm:p-7">
  <h2 class="text-lg font-semibold"><%= t("budgets.performance") %></h2><p class="mt-1 text-sm text-muted"><%= t("budgets.performance_help") %></p>
  <div class="mt-5 overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="text-xs text-muted"><tr><th class="pb-3 pr-4"><%= t("budgets.month") %></th><th class="pb-3 pr-4 text-right"><%= t("budgets.plan") %></th><th class="pb-3 pr-4 text-right"><%= t("budgets.spent") %></th><th class="pb-3 text-right"><%= t("budgets.result") %></th></tr></thead><tbody class="divide-y divide-line"><% @performance.each do |period| %><tr><td class="py-3 pr-4 font-medium"><%= l(period.month, format: "%b %Y") %></td><td class="py-3 pr-4 text-right tabular-nums"><%= format_money(period.planned_minor, @budget.currency) %></td><td class="py-3 pr-4 text-right tabular-nums"><%= format_money(period.spent_minor, @budget.currency) %></td><td class="py-3 text-right font-semibold tabular-nums <%= period.remaining_minor.negative? ? 'text-amber-800' : 'text-positive' %>"><%= difference_label(period.remaining_minor, @budget.currency) %></td></tr><% end %></tbody></table></div>
</section>
<div class="mt-5 flex flex-wrap justify-between gap-3">
  <%= link_to new_budget_path(month: @budget.reporting_month.next_month.strftime("%Y-%m"), copy_from: @budget.id), class: "btn-secondary inline-flex items-center gap-2" do %><%= heroicon :document_duplicate, class: "size-5" %><%= t("budgets.copy_next") %><% end %>
  <%= button_to @budget, method: :delete, class: "inline-flex items-center gap-1.5 text-sm font-semibold text-muted hover:text-ink", form: { data: { turbo_confirm: t("budgets.delete_confirm") } } do %><%= heroicon :trash, class: "size-4" %><%= t("forms.delete") %><% end %>
</div>
