<% content_for :hide_header_add, true %>
<div class="mx-auto max-w-xl"><div><p class="page-eyebrow"><%= t("transactions.fast_entry") %></p><h1 class="page-title mt-1"><%= t("transactions.new_title") %></h1></div><% if @accounts.empty? %><div class="panel mt-6 p-8 text-center"><h2 class="font-semibold"><%= t("transactions.account_needed") %></h2><p class="mt-2 text-sm text-muted"><%= t("transactions.account_needed_body") %></p><%= link_to t("accounts.add"), new_financial_account_path, class: "btn-primary mt-5" %></div><% else %><div class="panel mt-6 p-5 sm:p-7"><%= render "form", transaction: @transaction %></div><% end %></div>
