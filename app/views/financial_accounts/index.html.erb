<div class="flex items-end justify-between gap-4">
  <div><p class="page-eyebrow"><%= t("accounts.eyebrow") %></p><h1 class="page-title mt-1"><%= t("accounts.title") %></h1></div>
  <%= link_to new_financial_account_path, class: "btn-primary inline-flex items-center gap-2" do %><%= heroicon :plus, class: "size-5" %><%= t("accounts.add") %><% end %>
</div>
<% if @accounts.any? %>
  <section class="panel mt-6 p-5 sm:p-6"><div><h2 class="text-lg font-semibold"><%= t("accounts.net_worth") %></h2><p class="mt-1 text-sm text-muted"><%= t("accounts.net_worth_note") %></p></div><div class="mt-4 flex flex-wrap gap-x-8 gap-y-4"><% @net_worth.by_currency.each do |currency, position| %><div><p class="text-xs font-semibold uppercase tracking-wide text-subtle"><%= currency %></p><p class="mt-1 text-2xl font-semibold tabular-nums"><%= format_money(position[:net_worth_minor], currency) %></p><p class="mt-1 text-xs text-muted"><%= t("accounts.position_detail", assets: format_money(position[:assets_minor], currency), liabilities: format_money(position[:liabilities_minor], currency)) %></p></div><% end %></div></section>
  <% balance_rows = @net_worth.account_rows.index_by { |row| row[:account].id } %>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @accounts.each do |account| %>
      <% balance_minor = balance_rows.fetch(account.id)[:balance_minor] %>
      <% overdrawn = account.asset? && balance_minor.negative? %>
      <%= link_to account, class: "panel block p-5 transition hover:border-line-strong hover:shadow-md #{account.archived? ? 'opacity-60' : ''}" do %>
        <div class="flex items-center justify-between gap-3">
          <%= account_icon_tag(account) %>
          <span class="rounded-full bg-canvas px-2.5 py-1 text-xs font-medium text-muted"><%= account.archived? ? t("accounts.archived_label") : account.account_type.humanize %></span>
        </div>
        <h2 class="mt-4 font-semibold"><%= account.name %></h2>
        <p class="mt-1 text-2xl font-semibold tracking-tight <%= overdrawn ? 'text-negative' : 'text-ink' %>"><%= money_tag(balance_minor, account.currency) %></p>
        <p class="mt-1 text-xs uppercase tracking-wide <%= overdrawn ? 'text-negative' : 'text-subtle' %>"><%= account.currency %> · <%= overdrawn ? t("accounts.overdrawn") : (account.liability? ? t("accounts.liability") : t("accounts.asset")) %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="panel mt-6 p-10 text-center"><%= heroicon :wallet, class: "mx-auto size-10 text-line-strong" %><h2 class="mt-3 text-lg font-semibold"><%= t("accounts.empty_title") %></h2><p class="mt-2 text-muted"><%= t("accounts.empty_body") %></p><%= link_to t("accounts.add"), new_financial_account_path, class: "btn-primary mt-5" %></div>
<% end %>
